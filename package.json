{
  "name": "iceywu-devkit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"@iceywu/*\" build",
    "clean": "pnpm -r --filter \"@iceywu/*\" clean",
    "dev": "pnpm -r --parallel --filter \"@iceywu/*\" dev",
    "dev:playground": "pnpm --filter devkit-playground dev",
    "build:playground": "pnpm --filter devkit-playground build",
    "changeset": "changeset",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "publint": "pnpm -r --filter \"@iceywu/*\" exec publint",
    "release": "pnpm run release:check && pnpm exec changeset publish",
    "release:check": "pnpm run clean && pnpm run build && pnpm run check && pnpm run test && pnpm run publint",
    "typecheck": "pnpm -r --filter \"@iceywu/*\" typecheck",
    "test": "pnpm -r --if-present --filter \"@iceywu/*\" test",
    "version-packages": "changeset version",
    "check": "pnpm run validate:skills && pnpm run validate:playground-demos && pnpm run typecheck && pnpm -r --if-present --filter \"@iceywu/*\" run check:package",
    "validate:skills": "node ./tools/validate-skills.mjs",
    "validate:playground-demos": "pnpm --filter devkit-playground run check:demos"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^24.5.2",
    "publint": "^0.3.18",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "ultracite": "^7.2.5",
    "vitest": "^3.2.4"
  }
}
