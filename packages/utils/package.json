{
  "name": "@iceywu/utils",
  "version": "0.0.52",
  "description": "Collection of common JavaScript / TypeScript utils",
  "type": "module",
  "author": "Icey Wu <3128006406@qq.com>",
  "homepage": "https://github.com/IceyWu/iceywu-devkit/tree/main/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceyWu/iceywu-devkit.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/IceyWu/iceywu-devkit/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rimraf dist",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "debounce": "^2.2.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
